NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Local: SQLite (no Docker). Production: postgresql://...
DATABASE_URL=file:./data/alyson.db

# Local: true = no Redis required. Production: false + REDIS_URL
USE_INLINE_JOBS=true
REDIS_URL=redis://localhost:6379

# Local: true when no API keys. Set false when OPENAI_API_KEY (or other) is set.
MOCK_AI=true
MOCK_EMAIL=true

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

ENCRYPTION_KEY=change-me-32-byte-hex-or-passphrase-for-aes-256

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_AUTH_URL=
SALESFORCE_REST_URL=

GMASS_API_KEY=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=alyson-ai-assets

CORS_ORIGIN=http://localhost:5173,http://localhost:3000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

SCRAPING_REDDIT_INTERVAL_SEC=60
SCRAPING_TIKTOK_INTERVAL_SEC=120
DAILY_ARTICLE_CAP=1200

AUTO_PUBLISH_THRESHOLD=0.90
REVIEW_THRESHOLD=0.70
MODERATION_MODE=false
AUTO_RANK_INTERVAL_MIN=5

LOG_LEVEL=info
